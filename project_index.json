{
  "project_type": "single",
  "project_name": "aifactory-demo",
  "description": "Tiny FastAPI service used as demo target for AIFactory",
  "services": {
    "backend": {
      "path": ".",
      "tech_stack": ["python", "fastapi"],
      "port": 8000,
      "dev_command": "uvicorn src.app.main:app --reload",
      "test_command": "pytest tests/",
      "package_manager": "pip",
      "python_version": ">=3.10"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": null,
    "ci_cd": null
  },
  "conventions": {
    "linter": null,
    "formatter": null,
    "testing": "pytest",
    "test_location": "tests/",
    "test_pattern": "test_*.py",
    "source_location": "src/app/"
  },
  "dependencies": {
    "main": ["fastapi>=0.115", "uvicorn[standard]>=0.32"],
    "test": ["pytest>=8", "httpx>=0.27"]
  }
}
