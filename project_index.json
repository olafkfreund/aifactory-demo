{
  "project_type": "single",
  "services": {
    "backend": {
      "path": ".",
      "tech_stack": ["python", "fastapi"],
      "port": 8000,
      "dev_command": "uvicorn src.app.main:app --reload",
      "test_command": "pytest"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": null
  },
  "conventions": {
    "linter": "ruff",
    "formatter": "black",
    "testing": "pytest",
    "module_pattern": "Simple modules in src/app/ with pytest tests in tests/",
    "import_style": "Use src.app.* package imports",
    "test_naming": "test_*.py files with test_* functions"
  }
}
