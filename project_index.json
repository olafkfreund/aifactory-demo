{
  "project_type": "single",
  "services": {
    "backend": {
      "path": ".",
      "tech_stack": ["python", "fastapi"],
      "port": 8000,
      "dev_command": "uvicorn src.app.main:app --reload",
      "test_command": "pytest tests/"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": null
  },
  "conventions": {
    "linter": "ruff",
    "formatter": "black",
    "testing": "pytest",
    "language": "python",
    "min_python": "3.10"
  },
  "build_config": {
    "build_system": "hatchling",
    "package_name": "aifactory-demo",
    "entry_point": "src/app/main:app"
  }
}
