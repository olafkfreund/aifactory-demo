{
  "project_type": "single",
  "project_name": "aifactory-demo",
  "description": "Tiny FastAPI service used as the demo target for AIFactory.",
  "services": {
    "backend": {
      "path": ".",
      "tech_stack": ["python", "fastapi", "uvicorn"],
      "language": "python",
      "python_version": ">=3.10",
      "framework": "fastapi",
      "port": 8000,
      "dev_command": "uvicorn src.app.main:app --reload",
      "test_command": "pytest tests/",
      "lint_command": "ruff check src/ tests/",
      "type_check_command": "mypy src/ --no-error-summary 2>/dev/null || true"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": false,
    "package_manager": "pip"
  },
  "conventions": {
    "linter": "ruff",
    "formatter": "black",
    "testing": "pytest",
    "type_hints": true,
    "docstring_style": "google",
    "code_patterns": {
      "modules": "Include module docstring at top",
      "functions": "Use type hints, include docstring",
      "tests": "Use pytest, import from app module directly"
    }
  },
  "build_tool": "hatchling",
  "package_config": "pyproject.toml",
  "source_root": "src/app",
  "test_root": "tests"
}
