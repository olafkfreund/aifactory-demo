{
  "project_type": "single",
  "project_name": "aifactory-demo",
  "description": "Tiny FastAPI service used as AIFactory demo target",
  "services": {
    "backend": {
      "path": ".",
      "tech_stack": ["python", "fastapi", "uvicorn"],
      "python_version": ">=3.10",
      "port": 8000,
      "dev_command": "uvicorn src.app.main:app --reload",
      "install_command": "pip install -e .",
      "test_command": "pytest",
      "entry_point": "src/app/main.py"
    }
  },
  "infrastructure": {
    "docker": false,
    "ci_cd": "github_actions",
    "database": "none"
  },
  "conventions": {
    "linter": "ruff",
    "formatter": "black",
    "testing_framework": "pytest",
    "test_location": "tests/",
    "source_location": "src/",
    "test_pattern": "test_*.py",
    "module_imports": "from src.app.* import"
  },
  "build_system": {
    "type": "hatchling",
    "project_file": "pyproject.toml",
    "wheel_packages": ["src/app"]
  },
  "dependencies": {
    "runtime": ["fastapi>=0.115", "uvicorn[standard]>=0.32"],
    "test": ["pytest>=8", "httpx>=0.27"]
  }
}
