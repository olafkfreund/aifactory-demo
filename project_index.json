{
  "project_type": "single",
  "project_name": "aifactory-demo",
  "description": "Tiny FastAPI service used as the demo target for AIFactory",
  "services": {
    "backend": {
      "path": ".",
      "tech_stack": ["python", "fastapi", "uvicorn"],
      "python_version": ">=3.10",
      "port": 8000,
      "dev_command": "uvicorn src.app.main:app --reload",
      "test_command": "pytest tests/",
      "entry_point": "src/app/main.py"
    }
  },
  "infrastructure": {
    "docker": false,
    "database": null,
    "cache": null
  },
  "conventions": {
    "linter": "ruff",
    "formatter": "black",
    "testing": "pytest",
    "test_location": "tests/",
    "source_location": "src/app/",
    "test_file_pattern": "test_*.py"
  },
  "dependencies": {
    "runtime": ["fastapi>=0.115", "uvicorn[standard]>=0.32"],
    "testing": ["pytest>=8", "httpx>=0.27"]
  }
}
